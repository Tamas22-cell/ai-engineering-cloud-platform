{
  "name": "AI Engineering Cloud Platform",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [
    8000,
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Next.js (development)",
      "onAutoForward": "notify",
      "visibility": "private"
    },
    "8000": {
      "label": "FastAPI (development)",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "python -m pip install -r backend/requirements.txt && npm --prefix frontend ci",
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/backend"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}

FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/backend
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY backend /app/backend
COPY migrations /app/migrations
COPY alembic.ini /app/alembic.ini
EXPOSE 10000
CMD ["sh", "-c", "if [ -n \"${DATABASE_URL:-}\" ]; then python -m alembic upgrade head || exit 1; python -m scripts.seed_public_model || echo 'MLOps optional seed skipped'; fi; exec uvicorn main:app --app-dir backend --host 0.0.0.0 --port ${PORT:-10000}"]
